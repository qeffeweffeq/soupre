    "URL": {
      "id": "jlOF",
      "name": "URL",
      "type": "formula",
      "formula": {
        "expression": "let(\n  /* 1a. Extract: Get the raw path based on properties */\n  raw_path, ifs(\n    !empty(prop(\"Custom Slug\")), prop(\"Custom Slug\"),\n    !empty(prop(\"Parent Slug\")), prop(\"Parent Slug\") + \"/\" + prop(\"Page Slug\"),\n    prop(\"Page Slug\")\n  ),\n  \n  /* 1b. Transform: If the path contains 'homepage', make it blank */\n  path_str, if(test(lower(raw_path), \"homepage\"), \"\", raw_path),\n  \n  /* 2. Extract & Transform: Define the Market Prefix */\n  market_prefix, ifs(\n    format(prop(\"Market\")) == \"DEU\", \"/de\",\n    format(prop(\"Market\")) == \"INT\", \"/en\",\n    \"\"\n  ),\n  \n  /* 3. Load: Construct the Generated Friendly URL */\n  /* Ensures no trailing slash is left if the path_str is blank */\n  friendly_url, \"palacelidosuites.com\" + market_prefix + if(empty(path_str), \"\", \"/\" + path_str),\n  \n  /* 4. Final Output Logic: Evaluate Overrides */\n  ifs(\n    prop(\"Custom URL\"), prop(\"Custom URL Value\"),\n    \"https://\" + friendly_url\n  )\n)\n\t"
      }
    },
    "Path": {
      "id": "maBi",
      "name": "Path",
      "type": "formula",
      "formula": {
        "expression": "let(\n  generatedSlug,\n  ifs(\n    and(empty(prop(\"Parent Slug\")), empty(prop(\"Custom Slug\"))), prop(\"Page Slug\"),\n    and(!empty(prop(\"Parent Slug\")), empty(prop(\"Custom Slug\"))), prop(\"Parent Slug\") + \"/\" + prop(\"Page Slug\"),\n    !empty(prop(\"Custom Slug\")), prop(\"Custom Slug\")\n  ),\n  if(test(generatedSlug, \"homepage\"), \"\", generatedSlug)\n)"
      }
    },
