      "id": "rRWo",
      "name": "Friendly URL",
      "type": "formula",
      "formula": {
        "expression": "let(\n  /* Define the base domain and market routing once */\n  base_url, \"palacelidosuites.com\" + ifs(\n    format(prop(\"Market\")) == \"DEU\", \"/de\", \n    format(prop(\"Market\")) == \"INT\", \"/en\", \n    \"\"\n  ),\n  \n  /* Output logic */\n  ifs(\n    prop(\"Custom URL\"), \"\", \n    base_url + \"/\" + prop(\"Path\")\n  )\n)"
      }
    },
    "Page Slug": {
      "id": "%7D%3A%3BZ",
