    "Meta 30D Self": {
      "id": "Usou",
      "name": "Meta 30D Self",
      "type": "formula",
      "formula": {
        "expression": "if(\n  !empty(prop(\"30D Self\")), \n  \"📆 30D Self → \" + \n  if(\n    prop(\"30D Self\") >= 1000000, \n    /* Case: Millions */\n    \"€ \" + \n    format(floor(prop(\"30D Self\") / 1000000)) + \".\" + \n    padStart(format(floor(mod(prop(\"30D Self\"), 1000000) / 1000)), 3, \"0\") + \".\" + \n    padStart(format(floor(mod(prop(\"30D Self\"), 1000))), 3, \"0\") + \",\" + \n    padStart(format(round(mod(prop(\"30D Self\"), 1) * 100)), 2, \"0\"), \n    if(\n      prop(\"30D Self\") >= 1000, \n      /* Case: Thousands */\n      \"€ \" + \n      format(floor(prop(\"30D Self\") / 1000)) + \".\" + \n      padStart(format(floor(mod(prop(\"30D Self\"), 1000))), 3, \"0\") + \",\" + \n      padStart(format(round(mod(prop(\"30D Self\"), 1) * 100)), 2, \"0\"), \n      /* Case: Hundreds/Units */\n      \"€ \" + \n      format(floor(prop(\"30D Self\"))) + \",\" + \n      padStart(format(round(mod(prop(\"30D Self\"), 1) * 100)), 2, \"0\")\n    )\n  ), \n  \"\"\n)"
      }
    },
