        "expression": "lets(\n  /* Define the variable once */\n  val, prop(\"CY Self\"),\n  \n  if(\n    !empty(val),\n    \"🗓️ CY Self → \" + \n    if(\n      val >= 1000000,\n      \"€ \" + format(floor(val / 1000000)) + \".\" + \n      padStart(format(floor(mod(val, 1000000) / 1000)), 3, \"0\") + \".\" + \n      padStart(format(floor(mod(val, 1000))), 3, \"0\") + \",\" + \n      padStart(format(round(mod(val, 1) * 100)), 2, \"0\"),\n      if(\n        val >= 1000,\n        \"€ \" + format(floor(val / 1000)) + \".\" + \n        padStart(format(floor(mod(val, 1000))), 3, \"0\") + \",\" + \n        padStart(format(round(mod(val, 1) * 100)), 2, \"0\"),\n        \"€ \" + format(floor(val)) + \",\" + \n        padStart(format(round(mod(val, 1) * 100)), 2, \"0\")\n      )\n    ),\n    \"\"\n  )\n)"
      }
